{
  "name": "opencode-webui",
  "displayName": "OpenCode WebUI",
  "description": "Integrates the OpenCode web UI into a right-side panel of VS Code. Fork with fixed port, direct connection and Windows process detection.",
  "version": "1.0.0",
  "publisher": "jtian",
  "repository": {
    "type": "git",
    "url": "https://github.com/agustin-gigena/opencode-sidebar-web"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:opencode-webui.openPanel",
    "onCommand:opencode-webui.startServer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-webui",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-webui": [
        {
          "type": "webview",
          "id": "opencode-webui.view",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode-webui.openPanel",
        "title": "OpenCode: Open Panel",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "opencode-webui.closePanel",
        "title": "OpenCode: Close Panel",
        "icon": {
          "light": "media/icon-close.svg",
          "dark": "media/icon-close.svg"
        }
      },
      {
        "command": "opencode-webui.startServer",
        "title": "OpenCode: Start Server"
      },
      {
        "command": "opencode-webui.stopServer",
        "title": "OpenCode: Stop Server"
      },
      {
        "command": "opencode-webui.restartServer",
        "title": "OpenCode: Restart Server"
      },
      {
        "command": "opencode-webui.openFile",
        "title": "OpenCode: Open File"
      },
      {
        "command": "opencode-webui.focusPanel",
        "title": "OpenCode: Focus Panel"
      },
      {
        "command": "opencode-webui.installBinary",
        "title": "OpenCode: Install opencode binary"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode-webui.openPanel",
          "group": "navigation",
          "when": "!config.opencode-webui.hideButton"
        }
      ],
      "view/title": [
        {
          "command": "opencode-webui.startServer",
          "when": "view == opencode-webui.view && !opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-webui.stopServer",
          "when": "view == opencode-webui.view && opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-webui.restartServer",
          "when": "view == opencode-webui.view && opencodeSidebarServerRunning",
          "group": "navigation"
        },
        {
          "command": "opencode-webui.installBinary",
          "when": "view == opencode-webui.view && !opencodeSidebarBinaryInstalled",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode-webui.openPanel",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ],
    "configuration": {
      "title": "OpenCode Sidebar Web",
      "properties": {
        "opencode-webui.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the OpenCode server automatically when VS Code opens"
        },
        "opencode-webui.hostname": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Hostname for the OpenCode server"
        },
        "opencode-webui.hideButton": {
          "type": "boolean",
          "default": false,
          "description": "Hide the OpenCode button in the editor title bar"
        },
        "opencode-webui.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "Retry connection automatically when the server goes down"
        },
        "opencode-webui.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of reconnection attempts"
        },
        "opencode-webui.sidebarPosition": {
          "type": "string",
          "default": "right",
          "enum": [
            "right"
          ],
          "description": "OpenCode always appears in the secondary sidebar (right side). This option is kept for compatibility."
        },
        "opencode-webui.devcontainerMode": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect opencode running in a devcontainer/remote environment"
        },
        "opencode-webui.autoInstallInDevcontainer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install opencode on activation in a devcontainer if not present"
        },
        "opencode-webui.serverPort": {
          "type": "number",
          "default": 4096,
          "description": "Fixed port used when starting the OpenCode server (0 = random). Default 4096 matches opencode.json server.port, so browser settings like color scheme persist across restarts."
        },
        "opencode-webui.connectExistingLocal": {
          "type": "boolean",
          "default": true,
          "description": "Detect and connect to an existing OpenCode server (default port 4096) even in a local (non-remote) environment"
        },
        "opencode-webui.proxyPort": {
          "type": "number",
          "default": 4097,
          "description": "Fixed port for the local proxy injected between the webview and the OpenCode server. The proxy strips frame-blocking headers and injects a settings/theme bridge script. 0 = random port. Use a fixed port so the WebUI keeps its browser-stored settings (color scheme, theme) across restarts."
        },
        "opencode-webui.webuiSettingsBridge": {
          "type": "boolean",
          "default": true,
          "description": "Enable the settings bridge: always route the webview through the local proxy and inject a script into the WebUI page that listens for theme sync and 'open WebUI settings' requests. Disable to connect the webview directly to the server (no bridge features)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "opencode-ai": "^1.15.10"
  }
}
